/**
 * @fileoverview Firestore Security Rules for the e-commerce application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict admin-only access model for managing core application data. Public read access is granted where necessary for the user-facing storefront.
 *
 * Data Structure:
 * - /products/{productId}: Stores product information. Publicly readable.
 * - /categories/{categoryId}: Stores category information. Publicly readable.
 * - /banners/{bannerId}: Stores promotional banner information. Publicly readable.
 * - /roles_admin/{uid}: Indicates admin privileges; presence of a document for a user grants admin rights.
 * - /settings/enquiry: Stores WhatsApp enquiry settings. Publicly readable, admin writable.
 *
 * Key Security Decisions:
 * - Public read access: All users (authenticated or not) can read products, categories, banners, and enquiry settings.
 * - Admin-only write access: All write operations on core data collections are restricted to admin users.
 * - Authorization Independence: Admin status is determined solely by the existence of a document in /roles_admin/{uid}, avoiding costly `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Verified Identity: Ensures that all authorization decisions are based on a verified user identity.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is an admin by verifying the existence of their UID in the roles_admin collection.
     * @path N/A
     * @allow N/A
     * @deny N/A
     * @principle Role-Based Access Control: Only users with an admin role can access certain resources.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for the /products collection.
     * @path /products/{productId}
     * @allow (read) Anyone can view products.
     * @allow (write) An admin can manage products.
     * @deny (write) A non-admin attempts to manage a product.
     * @principle Public Read, Admin Write: Allows public visibility of products while securing management.
     */
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for the /categories collection.
     * @path /categories/{categoryId}
     * @allow (read) Anyone can view categories.
     * @allow (write) An admin can manage categories.
     * @deny (write) A non-admin attempts to manage a category.
     * @principle Public Read, Admin Write: Allows public visibility of categories while securing management.
     */
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for the /banners collection.
     * @path /banners/{bannerId}
     * @allow (read) Anyone can view banners.
     * @allow (write) An admin can manage banners.
     * @deny (write) A non-admin attempts to manage a banner.
     * @principle Public Read, Admin Write: Allows public visibility of banners while securing management.
     */
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Rules for the /roles_admin collection.
     * @path /roles_admin/{uid}
     * @allow (get) Any signed-in user's token can be used by server-side rules (like Storage rules) to check for a document's existence. This rule does NOT allow client-side reads.
     * @allow (list, write) Only admins can manage other admin roles.
     * @deny (write) A non-admin attempts to create an admin role.
     */
    match /roles_admin/{uid} {
        allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow list, create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /settings document. This allows storing various app settings.
     * @path /settings/{settingId}
     * @allow (read) Anyone can read settings.
     * @allow (write) Only admins can change settings.
     * @deny (write) A non-admin attempts to change a setting.
     */
    match /settings/{settingId} {
        allow read: if settingId == 'enquiry' || isAdmin();
        allow write: if isAdmin();
    }

    // New multi-vendor collections are restricted until the corresponding
    // validated server workflows and emulator tests are ready.
    match /seller_applications/{applicationId} {
      // Only an authenticated profile can request seller access.
      // Applications are UID-scoped; submission never grants seller privileges.
      allow create: if isSignedIn() && applicationId == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'businessName', 'businessCategory',
          'contactEmail', 'contactPhone', 'description',
          'status', 'submittedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'ownerUid', 'businessName', 'businessCategory',
          'contactEmail', 'contactPhone', 'description',
          'status', 'submittedAt'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() >= 2 &&
        request.resource.data.businessName.size() <= 120 &&
        request.resource.data.businessCategory in ['home-bakery', 'art', 'handmade', 'other'] &&
        request.resource.data.contactEmail is string &&
        request.resource.data.contactEmail.size() >= 3 &&
        request.resource.data.contactEmail.size() <= 254 &&
        request.resource.data.contactPhone is string &&
        request.resource.data.contactPhone.size() >= 5 &&
        request.resource.data.contactPhone.size() <= 40 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 1 &&
        request.resource.data.description.size() <= 2000 &&
        request.resource.data.submittedAt == request.time;
      allow get: if isAdmin() || (request.auth != null && applicationId == request.auth.uid);
      allow list, update, delete: if isAdmin();
    }
    function validDeliveryPincodes(codes) {
      return codes is list && codes.size() <= 10 &&
        (codes.size() <= 0 || (codes[0] is string && codes[0].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 1 || (codes[1] is string && codes[1].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 2 || (codes[2] is string && codes[2].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 3 || (codes[3] is string && codes[3].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 4 || (codes[4] is string && codes[4].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 5 || (codes[5] is string && codes[5].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 6 || (codes[6] is string && codes[6].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 7 || (codes[7] is string && codes[7].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 8 || (codes[8] is string && codes[8].matches('^[0-9]{6}$'))) &&
        (codes.size() <= 9 || (codes[9] is string && codes[9].matches('^[0-9]{6}$')));
    }
    function validDeliverySlots(slots) {
      return slots is list && slots.size() <= 6 &&
        (slots.size() <= 0 || (slots[0] is string && slots[0].size() > 0 && slots[0].size() <= 60)) &&
        (slots.size() <= 1 || (slots[1] is string && slots[1].size() > 0 && slots[1].size() <= 60)) &&
        (slots.size() <= 2 || (slots[2] is string && slots[2].size() > 0 && slots[2].size() <= 60)) &&
        (slots.size() <= 3 || (slots[3] is string && slots[3].size() > 0 && slots[3].size() <= 60)) &&
        (slots.size() <= 4 || (slots[4] is string && slots[4].size() > 0 && slots[4].size() <= 60)) &&
        (slots.size() <= 5 || (slots[5] is string && slots[5].size() > 0 && slots[5].size() <= 60));
    }

    match /sellers/{sellerId} {
      // A signed-in user may read their own UID document even if it does not yet
      // exist. This is needed for a reliable non-seller role lookup.
      // Client reads do not grant seller permissions: writes still require sellerActive().
      allow get: if isAdmin() || (isSignedIn() && sellerId == request.auth.uid) ||
        resource.data.status == 'active';
      allow list: if isAdmin() || resource.data.status == 'active';
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        sellerId == request.auth.uid &&
        resource.data.ownerUid == request.auth.uid &&
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description', 'contactPhone', 'whatsappNumber', 'isOpen', 'updatedAt',
          'deliveryMethods', 'deliveryPincodes', 'deliveryFee', 'pickupAddress',
          'deliverySlots', 'dailyOrderCapacity', 'acceptanceHours'
        ]) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000 &&
        request.resource.data.contactPhone is string &&
        request.resource.data.contactPhone.size() <= 40 &&
        (!('whatsappNumber' in request.resource.data) ||
          (request.resource.data.whatsappNumber is string &&
            (request.resource.data.whatsappNumber == '' ||
              request.resource.data.whatsappNumber.matches('^[0-9]{8,15}$')))) &&
        request.resource.data.isOpen is bool &&
        (!('deliveryMethods' in request.resource.data) ||
          (request.resource.data.deliveryMethods is list &&
           request.resource.data.deliveryMethods.size() >= 1 &&
           request.resource.data.deliveryMethods.size() <= 2 &&
           request.resource.data.deliveryMethods.hasOnly(['delivery','pickup']))) &&
        (!('deliveryPincodes' in request.resource.data) || validDeliveryPincodes(request.resource.data.deliveryPincodes)) &&
        (!('deliverySlots' in request.resource.data) || validDeliverySlots(request.resource.data.deliverySlots)) &&
        (!('deliveryFee' in request.resource.data) ||
          (request.resource.data.deliveryFee is number && request.resource.data.deliveryFee >= 0 && request.resource.data.deliveryFee <= 5000)) &&
        (!('pickupAddress' in request.resource.data) ||
          (request.resource.data.pickupAddress is string && request.resource.data.pickupAddress.size() <= 500)) &&
        (!('dailyOrderCapacity' in request.resource.data) ||
          (request.resource.data.dailyOrderCapacity is int && request.resource.data.dailyOrderCapacity >= 0 && request.resource.data.dailyOrderCapacity <= 100)) &&
        (!('acceptanceHours' in request.resource.data) ||
          (request.resource.data.acceptanceHours is int && request.resource.data.acceptanceHours >= 1 && request.resource.data.acceptanceHours <= 72)) &&
        request.resource.data.updatedAt == request.time
      );
    }

    function sellerActive(sellerId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/sellers/$(sellerId)) &&
        get(/databases/$(database)/documents/sellers/$(sellerId)).data.ownerUid == request.auth.uid &&
        get(/databases/$(database)/documents/sellers/$(sellerId)).data.status == 'active' &&
        get(/databases/$(database)/documents/sellers/$(sellerId)).data.accessEndsAt > request.time;
    }

    // Limit seller-configured question labels before displaying them in the buyer UI.
    function validCustomizationPrompts(prompts) {
      return prompts is list && prompts.size() <= 6 &&
        (prompts.size() <= 0 || (prompts[0] is string && prompts[0].size() >= 1 && prompts[0].size() <= 80)) &&
        (prompts.size() <= 1 || (prompts[1] is string && prompts[1].size() >= 1 && prompts[1].size() <= 80)) &&
        (prompts.size() <= 2 || (prompts[2] is string && prompts[2].size() >= 1 && prompts[2].size() <= 80)) &&
        (prompts.size() <= 3 || (prompts[3] is string && prompts[3].size() >= 1 && prompts[3].size() <= 80)) &&
        (prompts.size() <= 4 || (prompts[4] is string && prompts[4].size() >= 1 && prompts[4].size() <= 80)) &&
        (prompts.size() <= 5 || (prompts[5] is string && prompts[5].size() >= 1 && prompts[5].size() <= 80));
    }

    function validWeightOption(w) {
      return w is map && w.keys().hasOnly(['value','unit','price','stockQuantity']) &&
        w.keys().hasAll(['value','unit']) &&
        w.value is number && w.value > 0 && w.value <= 100000 &&
        w.unit in ['g','kg','ml','l','pieces'] &&
        (!('price' in w) || (w.price is number && w.price >= 0 && w.price <= 10000000)) &&
        (!('stockQuantity' in w) || (w.stockQuantity is int && w.stockQuantity >= 0 && w.stockQuantity <= 1000000));
    }
    function validWeightOptions(options) {
      return options is list && options.size() <= 8 &&
        (options.size() <= 0 || validWeightOption(options[0])) &&
        (options.size() <= 1 || validWeightOption(options[1])) &&
        (options.size() <= 2 || validWeightOption(options[2])) &&
        (options.size() <= 3 || validWeightOption(options[3])) &&
        (options.size() <= 4 || validWeightOption(options[4])) &&
        (options.size() <= 5 || validWeightOption(options[5])) &&
        (options.size() <= 6 || validWeightOption(options[6])) &&
        (options.size() <= 7 || validWeightOption(options[7]));
    }

    function validFoodLabels(labels) {
      return labels is list && labels.size() <= 12 &&
        (labels.size() <= 0 || (labels[0] is string && labels[0].size() > 0 && labels[0].size() <= 40)) &&
        (labels.size() <= 1 || (labels[1] is string && labels[1].size() > 0 && labels[1].size() <= 40)) &&
        (labels.size() <= 2 || (labels[2] is string && labels[2].size() > 0 && labels[2].size() <= 40)) &&
        (labels.size() <= 3 || (labels[3] is string && labels[3].size() > 0 && labels[3].size() <= 40)) &&
        (labels.size() <= 4 || (labels[4] is string && labels[4].size() > 0 && labels[4].size() <= 40)) &&
        (labels.size() <= 5 || (labels[5] is string && labels[5].size() > 0 && labels[5].size() <= 40)) &&
        (labels.size() <= 6 || (labels[6] is string && labels[6].size() > 0 && labels[6].size() <= 40)) &&
        (labels.size() <= 7 || (labels[7] is string && labels[7].size() > 0 && labels[7].size() <= 40)) &&
        (labels.size() <= 8 || (labels[8] is string && labels[8].size() > 0 && labels[8].size() <= 40)) &&
        (labels.size() <= 9 || (labels[9] is string && labels[9].size() > 0 && labels[9].size() <= 40)) &&
        (labels.size() <= 10 || (labels[10] is string && labels[10].size() > 0 && labels[10].size() <= 40)) &&
        (labels.size() <= 11 || (labels[11] is string && labels[11].size() > 0 && labels[11].size() <= 40));
    }
    function validMarketplaceProduct(p) {
      return p.keys().hasOnly([
        'sellerId', 'name', 'description', 'price', 'category', 'imageUrls',
        'showPrice', 'availability', 'stockQuantity', 'preparationDays',
        'minimumOrderQuantity', 'weightValue', 'weightUnit', 'weightOptions', 'customizationOptions',
        'careInstructions', 'ingredients', 'allergens', 'dietaryTags', 'shelfLifeDays', 'storageInstructions',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      p.sellerId is string &&
      p.name is string && p.name.size() >= 2 && p.name.size() <= 120 &&
      p.description is string && p.description.size() <= 2000 &&
      p.category is string && p.category.size() > 0 && p.category.size() <= 80 &&
      p.price is number && p.price >= 0 && p.price <= 10000000 &&
      p.imageUrls is list && p.imageUrls.size() <= 10 &&
      p.showPrice is bool &&
      p.availability in ['available', 'unavailable', 'made-to-order'] &&
      p.stockQuantity is int && p.stockQuantity >= 0 &&
      p.preparationDays is int && p.preparationDays >= 0 &&
      p.status in ['draft', 'published'] &&
      (!('minimumOrderQuantity' in p) || (p.minimumOrderQuantity is int && p.minimumOrderQuantity >= 1 && p.minimumOrderQuantity <= 99)) &&
      (!('weightValue' in p) || (p.weightValue is number && p.weightValue > 0 && p.weightValue <= 100000)) &&
      (!('weightUnit' in p) || p.weightUnit in ['g', 'kg', 'ml', 'l', 'pieces']) &&
      (!('weightOptions' in p) || validWeightOptions(p.weightOptions)) &&
      (('weightValue' in p) == ('weightUnit' in p)) &&
      (!('careInstructions' in p) || (p.careInstructions is string && p.careInstructions.size() <= 500)) &&
      (!('customizationOptions' in p) || validCustomizationPrompts(p.customizationOptions)) &&
      (!('ingredients' in p) || (p.ingredients is string && p.ingredients.size() <= 1000)) &&
      (!('storageInstructions' in p) || (p.storageInstructions is string && p.storageInstructions.size() <= 500)) &&
      (!('shelfLifeDays' in p) || (p.shelfLifeDays is int && p.shelfLifeDays >= 0 && p.shelfLifeDays <= 365)) &&
      (!('allergens' in p) || validFoodLabels(p.allergens)) &&
      (!('dietaryTags' in p) || validFoodLabels(p.dietaryTags)) &&

      p.createdAt is timestamp && p.updatedAt is timestamp;
    }

    match /marketplace_products/{productId} {
      // Public queries must include where('status', '==', 'published').
      // Seller dashboard queries must include where('sellerId', '==', auth.uid).
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid) ||
        resource.data.status == 'published';
      allow create: if sellerActive(request.resource.data.sellerId) &&
        request.resource.data.sellerId == request.auth.uid &&
        validMarketplaceProduct(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if sellerActive(resource.data.sellerId) &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validMarketplaceProduct(request.resource.data) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if sellerActive(resource.data.sellerId) &&
        resource.data.sellerId == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }
    // Order creation is server-only. Direct client writes bypass transactional inventory checks.

    match /product_reviews/{reviewId} {
      allow get, list: if isAdmin() ||
        resource.data.status == 'published' ||
        (isSignedIn() && resource.data.buyerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /support_tickets/{ticketId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /support_limits/{limitId} {
      allow read, write: if false;
    }
    match /favorites/{uid}/items/{productId} {
      allow get, list, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['productId','title','imageUrl','createdAt']) &&
        request.resource.data.keys().hasAll(['productId','title','imageUrl','createdAt']) &&
        request.resource.data.productId == productId &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120 &&
        request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2000 &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
    }
    match /customer_addresses/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['recipient','phone','line1','locality','district','state','pincode','updatedAt']) &&
        request.resource.data.keys().hasAll(['recipient','phone','line1','locality','district','state','pincode','updatedAt']) &&
        request.resource.data.recipient is string && request.resource.data.recipient.size() > 0 && request.resource.data.recipient.size() <= 120 &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 5 && request.resource.data.phone.size() <= 40 &&
        request.resource.data.line1 is string && request.resource.data.line1.size() >= 10 && request.resource.data.line1.size() <= 600 &&
        request.resource.data.locality is string && request.resource.data.locality.size() <= 120 &&
        request.resource.data.district is string && request.resource.data.district.size() > 0 && request.resource.data.district.size() <= 120 &&
        request.resource.data.state is string && request.resource.data.state.size() > 0 && request.resource.data.state.size() <= 120 &&
        request.resource.data.pincode is string && request.resource.data.pincode.matches('^[0-9]{6}$') &&
        request.resource.data.updatedAt == request.time;
    }

    match /checkout_orders/{checkoutId} {
      allow read, write: if false;
    }

    match /seller_orders/{orderId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.buyerUid == request.auth.uid) ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /custom_quotes/{quoteId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.buyerUid == request.auth.uid) ||
        (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /quote_limits/{quotaId} {
      allow read, write: if false;
    }
    match /seller_bookings/{bookingId} {
      allow read, write: if false;
    }
    match /notifications/{uid}/items/{itemId} {
      allow get, list: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }
    match /conversations/{conversationId}/{nested=**} {
      allow read, write: if false;
    }
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

  }
}
