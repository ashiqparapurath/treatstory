# Generated into private/gateway.conf by configure.py; never commit the rendered file.
# A secret header from TreatStory's server-to-server API is mandatory.
map $http_x_treatstory_matrix_gateway $treatstory_matrix_allowed {
    default 0;
    "__GATEWAY_SECRET__" 1;
}
server {
    listen 443 ssl;
    server_name __GATEWAY_HOST__;
    server_tokens off;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log off;
    client_max_body_size 256k;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        if ($treatstory_matrix_allowed = 0) { return 403; }
        proxy_pass http://synapse:8008;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Treatstory-Matrix-Gateway "";
        proxy_read_timeout 40s;
        proxy_send_timeout 40s;
        proxy_connect_timeout 5s;
    }
}
