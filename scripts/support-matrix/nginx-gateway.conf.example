# Production template, not a runnable deployment. Terminate TLS, configure the
# upstream private network and inject the secret using your secrets manager.
# Never expose the upstream Synapse listener or admin listener publicly.
map $http_x_treatstory_matrix_gateway $treatstory_matrix_authorized {
    default 0;
    "REPLACE_USING_SECURE_SECRET_TEMPLATING" 1;
}
server {
    listen 443 ssl;
    server_name matrix.example.invalid;
    # Configure ssl_certificate / ssl_certificate_key through your TLS platform.
    client_max_body_size 256k;
    location / {
        if ($treatstory_matrix_authorized = 0) { return 403; }
        proxy_pass http://synapse:8008;
        proxy_set_header X-Treatstory-Matrix-Gateway "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 40s;
    }
}
